# ===========================================
# Production Environment Configuration
# ===========================================
# Copy this file to .env.production and fill in the values
# NEVER commit .env.production to version control!

# ===========================================
# Domain Configuration
# ===========================================
DOMAIN=prepareos.fr
ACME_EMAIL=admin@prepareos.fr

# ===========================================
# Database Configuration
# ===========================================
# Generate a secure password: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_SECURE_PASSWORD

# Database URL (used by API)
# This is constructed from the password above - update if password changes
DATABASE_URL=postgres://platform:${POSTGRES_PASSWORD}@platform-db:5432/platform

# ===========================================
# API Configuration
# ===========================================
# API Key for CI/CD deployments and external integrations
# Generate: openssl rand -hex 32
API_KEY=CHANGE_ME_GENERATE_SECURE_API_KEY

# Node environment
NODE_ENV=production

# ===========================================
# Admin Dashboard Configuration
# ===========================================
NEXT_PUBLIC_API_URL=https://api.prepareos.fr

# ===========================================
# Container Registry
# ===========================================
# Default Medusa image for tenant provisioning
DEFAULT_MEDUSA_IMAGE=ghcr.io/leconome/medusa:latest

# ===========================================
# VPS Connection (for CI/CD)
# ===========================================
# These should be set as GitHub Secrets, not in this file
# VPS_HOST=your-vps-ip
# VPS_USER=deploy
# VPS_SSH_KEY=base64-encoded-private-key

# ===========================================
# Backup Configuration (Optional)
# ===========================================
# S3-compatible storage for backups
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=

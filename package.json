{
  "name": "prepare-order-os",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel dev",
    "dev:store": "pnpm --filter store dev",
    "dev:client": "pnpm --filter client dev",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:push": "pnpm --filter store db:push",
    "db:studio": "pnpm --filter store db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.6.3",
  "engines": {
    "node": ">=22"
  }
}

# Provisioning API Environment Variables

# Database connection
DATABASE_URL=postgres://platform:platform@localhost:5433/platform

# Server port
PORT=3001

# Node environment
NODE_ENV=development

# Container Registry (public - no auth needed for pulls)
# Default image used when no version is specified
DEFAULT_MEDUSA_IMAGE=ghcr.io/leconome/medusa:latest

# API Authentication (for CI/CD image registration)
# Generate a secure key: openssl rand -base64 32
API_KEY=your-secure-api-key-here

# Production Dockerfile for Store API (Hono)
# Built from repo root to include workspace packages

# ==========================================
# Stage 1: Dependencies
# ==========================================
FROM node:22-alpine AS deps

WORKDIR /app

# Enable corepack for pnpm
RUN corepack enable && corepack prepare pnpm@10.6.3 --activate

# Copy workspace config and lockfile
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./

# Copy package.json files for workspace packages
COPY packages/store-types/package.json ./packages/store-types/
COPY apps/store/package.json ./apps/store/

# Install dependencies
RUN pnpm install --frozen-lockfile

# ==========================================
# Stage 2: Builder
# ==========================================
FROM node:22-alpine AS builder

WORKDIR /app

# Enable corepack for pnpm
RUN corepack enable && corepack prepare pnpm@10.6.3 --activate

# Copy dependencies
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/store-types/node_modules ./packages/store-types/node_modules
COPY --from=deps /app/apps/store/node_modules ./apps/store/node_modules

# Copy source files
COPY packages/store-types ./packages/store-types
COPY apps/store ./apps/store
COPY pnpm-workspace.yaml package.json ./

# Build store-types first
WORKDIR /app/packages/store-types
RUN pnpm build

# Build the store app
WORKDIR /app/apps/store
RUN pnpm build

# ==========================================
# Stage 3: Production Runner
# ==========================================
FROM node:22-alpine AS runner

WORKDIR /app

# Set production environment
ENV NODE_ENV=production

# Create non-root user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 hono

# Copy built artifacts
COPY --from=builder --chown=hono:nodejs /app/apps/store/dist ./dist
COPY --from=builder --chown=hono:nodejs /app/apps/store/package.json ./

# Copy production dependencies only
COPY --from=deps /app/apps/store/node_modules ./node_modules
COPY --from=deps /app/packages/store-types/dist ./node_modules/@repo/store-types/dist
COPY --from=deps /app/packages/store-types/package.json ./node_modules/@repo/store-types/

# Switch to non-root user
USER hono

# Expose port
EXPOSE 9000

# Start the application
CMD ["node", "dist/index.js"]

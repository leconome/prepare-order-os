# Production Dockerfile for Store API (Hono)
# Built from repo root to include workspace packages

# ==========================================
# Stage 1: Dependencies & Build
# ==========================================
FROM node:22-alpine AS builder

WORKDIR /app

# Enable corepack for pnpm
RUN corepack enable && corepack prepare pnpm@10.6.3 --activate

# Copy workspace config and lockfile
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./

# Copy package.json files for workspace packages
COPY packages/store-types/package.json ./packages/store-types/
COPY apps/store/package.json ./apps/store/

# Install all dependencies
RUN pnpm install --frozen-lockfile

# Copy source files
COPY packages/store-types ./packages/store-types
COPY apps/store ./apps/store

# Build store-types first
RUN pnpm --filter @repo/store-types build

# Build the store app
RUN pnpm --filter store build

# Install drizzle-kit in workspace (for migrations container)
RUN pnpm add -w -D drizzle-kit

# Use pnpm deploy to create a self-contained production bundle
# This resolves workspace:* -> real files, removes symlinks
RUN pnpm --filter store deploy --prod --legacy /app/deploy

# Copy drizzle-kit to deploy bundle for migrations
RUN cp -r node_modules/.pnpm/drizzle-kit*/node_modules/drizzle-kit /app/deploy/node_modules/ 2>/dev/null || true
RUN cp -r node_modules/drizzle-kit /app/deploy/node_modules/ 2>/dev/null || true

# ==========================================
# Stage 2: Production Runner
# ==========================================
FROM node:22-alpine AS runner

WORKDIR /app

# Set production environment
ENV NODE_ENV=production

# Copy the deployed bundle (includes node_modules with real files, not symlinks)
COPY --from=builder /app/deploy ./

# Copy built dist from the original location
COPY --from=builder /app/apps/store/dist ./dist

# Copy drizzle config and schema for migrations (can run via separate container)
COPY --from=builder /app/apps/store/drizzle.config.ts ./
COPY --from=builder /app/apps/store/src/db ./src/db

# Expose port
EXPOSE 9000

# Start the application (migrations run separately)
CMD ["node", "dist/index.js"]

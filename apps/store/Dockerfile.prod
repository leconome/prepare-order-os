# Production Dockerfile for Store API (Hono)
# Built from repo root to include workspace packages

# ==========================================
# Stage 1: Dependencies
# ==========================================
FROM node:22-alpine AS deps

WORKDIR /app

# Enable corepack for pnpm
RUN corepack enable && corepack prepare pnpm@10.6.3 --activate

# Copy workspace config and lockfile
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./

# Copy package.json files for workspace packages
COPY packages/store-types/package.json ./packages/store-types/
COPY apps/store/package.json ./apps/store/

# Install dependencies (need to use --no-frozen-lockfile for workspace resolution)
RUN pnpm install --filter @repo/store-types --filter store

# ==========================================
# Stage 2: Builder
# ==========================================
FROM node:22-alpine AS builder

WORKDIR /app

# Enable corepack for pnpm
RUN corepack enable && corepack prepare pnpm@10.6.3 --activate

# Copy everything from deps
COPY --from=deps /app ./

# Copy source files
COPY packages/store-types ./packages/store-types
COPY apps/store ./apps/store

# Build store-types first
RUN pnpm --filter @repo/store-types build

# Build the store app
RUN pnpm --filter store build

# ==========================================
# Stage 3: Production Runner
# ==========================================
FROM node:22-alpine AS runner

WORKDIR /app

# Set production environment
ENV NODE_ENV=production

# Create non-root user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 hono

# Copy built artifacts
COPY --from=builder --chown=hono:nodejs /app/apps/store/dist ./dist
COPY --from=builder --chown=hono:nodejs /app/apps/store/package.json ./

# Copy production dependencies and built store-types
COPY --from=builder --chown=hono:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=hono:nodejs /app/packages/store-types/dist ./node_modules/@repo/store-types/dist
COPY --from=builder --chown=hono:nodejs /app/packages/store-types/package.json ./node_modules/@repo/store-types/

# Switch to non-root user
USER hono

# Expose port
EXPOSE 9000

# Start the application
CMD ["node", "dist/index.js"]

# Production Dockerfile for Client Storefront
# Built from repo root to include workspace packages

# ==========================================
# Stage 1: Dependencies
# ==========================================
FROM node:20-alpine AS deps

WORKDIR /app

# Enable corepack for pnpm
RUN corepack enable && corepack prepare pnpm@10.6.3 --activate

# Copy workspace config and lockfile
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./

# Copy package.json files for workspace packages
COPY packages/store-types/package.json ./packages/store-types/
COPY apps/client/package.json ./apps/client/

# Install dependencies
RUN pnpm install --filter @repo/store-types --filter client

# ==========================================
# Stage 2: Builder
# ==========================================
FROM node:20-alpine AS builder

WORKDIR /app

# Enable corepack for pnpm
RUN corepack enable && corepack prepare pnpm@10.6.3 --activate

# Build arguments (must be set at build time for Next.js)
ARG NEXT_PUBLIC_STORE_API_URL
ARG NEXT_PUBLIC_DOMAIN
ENV NEXT_PUBLIC_STORE_API_URL=${NEXT_PUBLIC_STORE_API_URL}
ENV NEXT_PUBLIC_DOMAIN=${NEXT_PUBLIC_DOMAIN}

# Copy everything from deps
COPY --from=deps /app ./

# Copy source files
COPY packages/store-types ./packages/store-types
COPY apps/client ./apps/client

# Build store-types first
RUN pnpm --filter @repo/store-types build

# Set production environment for build
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Build the Next.js application
RUN pnpm --filter client build

# ==========================================
# Stage 3: Production Runner
# ==========================================
FROM node:20-alpine AS runner

WORKDIR /app

# Set production environment
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Create non-root user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy only necessary files from builder
COPY --from=builder /app/apps/client/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/apps/client/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/client/.next/static ./.next/static

# Switch to non-root user
USER nextjs

# Expose port
EXPOSE 3002

# Set hostname to allow external connections
ENV HOSTNAME="0.0.0.0"
ENV PORT=3002

# Start the application
CMD ["node", "server.js"]
